{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "场所目录",
  "type": "object",
  "required": ["venues"],
  "properties": {
    "venues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["venue_id", "name", "district", "domain", "owner_unit", "responsible_unit", "grid"],
        "properties": {
          "venue_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "district": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "owner_unit": {"type": "string", "minLength": 1},
          "responsible_unit": {"type": "string", "minLength": 1},
          "grid": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 2
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
