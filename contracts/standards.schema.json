{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "译写规范版本库",
  "type": "object",
  "required": ["standard_id", "title", "versions"],
  "properties": {
    "standard_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "effective_from", "status", "terms"],
        "properties": {
          "version": {"type": "integer", "minimum": 1},
          "effective_from": {"type": "string", "minLength": 1},
          "status": {"enum": ["current", "superseded"]},
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "approved"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "approved": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
